{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "lib": ["es2023"],
        "types": ["node", "jest"],
        "strict": true,
        "esModuleInterop": true,
        "noEmit": true
    },
    "include": [
        "src",
        "__test__",
        "index.ts",
        "jest.config.ts"
    ],
    "ts-node": {
        "swc": true
    }
}
